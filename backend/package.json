    "db:seed:timeline-emails": "tsx scripts/seedTimelineEmails.ts --all",
    "db:seed:timeline-emails:local": "tsx scripts/seedTimelineEmails.ts --local",
    "db:seed:timeline-emails:render": "tsx scripts/seedTimelineEmails.ts --render",
    "db:seed:new-escrow-emails": "tsx scripts/seedNewEscrowEmails.ts --all",
