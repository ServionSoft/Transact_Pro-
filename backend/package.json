    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:local": "tsx db/migrateLocal.ts",
    "db:repair:compass-tasks": "tsx db/repairCompassTasks.ts",
    "db:migrate:render": "tsx db/migrate.ts",
