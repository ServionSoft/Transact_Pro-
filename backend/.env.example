# Server
PORT=4000
NODE_ENV=development

# PostgreSQL — paste your connection string from pgAdmin (see backend README “Database connection”).
# Example (replace USER, PASSWORD, DATABASE):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/transactpro_dev
DATABASE_URL=

# From backend/ after DATABASE_URL is set:
#   npm run db:migrate
#   npm run db:seed:document-rules

# Local file uploads (created automatically; gitignored under backend/uploads by default)
UPLOAD_DIR=./uploads

# CRM Documents page — URL slug in the API vs real projects.id in Postgres (seed query gave id=1)
CRM_VAULT_PROJECT_ID=1
CRM_VAULT_SLUG=crm-doc-vault

# Optional: first team user id for uploaded_by_user_id until JWT auth exists
# DEFAULT_UPLOAD_USER_ID=1

# Auth (required for protected APIs)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
# JWT_ACCESS_SECRET also derives the AES key for SMTP passwords stored in smtp_settings (Settings → Email / SMTP).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Admin bootstrap for: npm run db:seed:admin-user
ADMIN_SEED_EMAIL=admin@transactpro.local
ADMIN_SEED_NAME=System Admin
ADMIN_SEED_PASSWORD=change_me_strong_password

# Public base URL for absolute download links when the browser runs on another port (e.g. Vite :8080, API :4000)
PUBLIC_API_URL=http://localhost:4000

# SPA base URL for invite links (e.g. http://localhost:8080). Falls back to FRONTEND_APP_URL.
PUBLIC_APP_URL=http://localhost:8080
# INVITE_TTL_HOURS=168

# CORS — comma-separated origins (must include the exact browser origin, e.g. http://localhost:8080 or http://127.0.0.1:8080)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# DocuSign (JWT + Connect) — restart the API after changing any DOCUSIGN_* value (tsx watch does not reload .env by itself).
# Production defaults shown; use demo.docusign.net + account-d.docusign.com for dev
# DOCUSIGN_INTEGRATION_KEY=your-integration-key-uuid
# DOCUSIGN_USER_ID=impersonated-user-uuid
# DOCUSIGN_ACCOUNT_ID=account-id-guid-or-numeric
# PEM as one line with \n escapes, or use DOCUSIGN_RSA_PRIVATE_KEY_PATH instead
# The **public** half of this keypair must be registered in DocuSign Admin → Apps and Keys → this Integration Key (RSA).
# If OAuth returns no_valid_keys_or_signatures, the PEM on disk does not match the public key saved in DocuSign.
# DOCUSIGN_RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# DOCUSIGN_RSA_PRIVATE_KEY_PATH=./secrets/docusign-private.pem
# Production REST + OAuth:
# DOCUSIGN_BASE_PATH=https://www.docusign.net/restapi
# DOCUSIGN_OAUTH_HOST=account.docusign.com
# Demo / developer (JWT consent URL must use account-d, not www.docusign.com):
# DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
# DOCUSIGN_OAUTH_HOST=account-d.docusign.com
# JWT consent: redirect_uri only — must match a Redirect URI in Apps and Keys (often https://www.docusign.com).
# DOCUSIGN_CONSENT_REDIRECT_URI=https://www.docusign.com
# Connect HMAC: required in production (see DocuSign Admin > Connect)
# DOCUSIGN_CONNECT_HMAC_KEY=
# DocuSign Connect must POST to a public HTTPS URL: /api/docusign/connect (same key as HMAC in Connect config).
# Optional: log envelope recipient payload + listRecipients after create (do not enable in production long-term)
# DOCUSIGN_DEBUG_ENVELOPE=true

# Google OAuth — Gmail / Drive (when integrated)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/google/callback
