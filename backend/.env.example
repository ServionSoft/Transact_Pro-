# Server
PORT=4000
NODE_ENV=development

# PostgreSQL — paste your connection string from pgAdmin (see backend README “Database connection”).
# Example (replace USER, PASSWORD, DATABASE):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/transactpro_dev
DATABASE_URL=

# Local file uploads (created automatically; gitignored under backend/uploads by default)
UPLOAD_DIR=./uploads

# CRM Documents page — URL slug in the API vs real projects.id in Postgres (seed query gave id=1)
CRM_VAULT_PROJECT_ID=1
CRM_VAULT_SLUG=crm-doc-vault

# Optional: first team user id for uploaded_by_user_id until JWT auth exists
# DEFAULT_UPLOAD_USER_ID=1

# Public base URL for absolute download links when the browser runs on another port (e.g. Vite :8080, API :4000)
PUBLIC_API_URL=http://localhost:4000

# CORS — comma-separated origins (Vite default 5173; this repo’s Vite often uses 8080)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# DocuSign (when integrated)
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_SECRET_KEY=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# Google OAuth — Gmail / Drive (when integrated)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/google/callback
