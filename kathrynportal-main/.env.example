# Backend API base URL (must match backend PORT, default 4000).
# Start the API from backend/: npm run dev — then document rules load/save will work.
# If you see "Failed to fetch", the API is not reachable at this URL or CORS blocked the browser.
# If the UI runs on another port, set backend PUBLIC_API_URL to the API URL so download_url links work.
VITE_API_URL=http://localhost:4000
