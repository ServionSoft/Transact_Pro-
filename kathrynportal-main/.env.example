# Backend API base URL (production / preview builds). In local dev, Vite proxies /api to :4000
# and the app uses the same origin automatically — no need to set your LAN IP here.
# Set VITE_API_DIRECT=true only if you want the browser to call the API port directly (e.g. Postman-style).
# Mobile on Wi‑Fi: open http://YOUR_PC_LAN_IP:8080 (not :4000). PC and phone must be on the same network.
VITE_API_URL=http://localhost:4000
# VITE_API_DIRECT=true

# Google Maps — address autocomplete on Add Transaction (optional; manual entry works without it)
# VITE_GOOGLE_MAPS_API_KEY=
